version: {{.Version}}

settings:
  upgrade:
    repository: AustinOyugi/no-oops-ops
  platform:
    network:
      name: noops-platform
    registry:
      name: noops-registry
      port: 5000
    ingress:
      name: noops-nginx
      http_port: 80
      https_port: 443
      # Enable only when every public ingress hostname is Cloudflare-proxied.
      cloudflare: false
    networks:
      default: "noops-{environment}"
      environments: {}

apps: {}
