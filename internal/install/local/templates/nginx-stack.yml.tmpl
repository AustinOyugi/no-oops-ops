version: "3.9"

services:
  nginx:
    image: nginx:1.28-alpine
    # The supervisor validates, renews config, and forwards graceful shutdown.
    entrypoint: ["/bin/sh"]
    command: ["/etc/noops/nginx/start-nginx.sh"]
    stop_signal: SIGQUIT
    stop_grace_period: 2m
    ports:
      - target: 80
        published: {{ .HTTPPort }}
        protocol: tcp
        mode: ingress
      - target: 443
        published: {{ .HTTPSPort }}
        protocol: tcp
        mode: ingress
    volumes:
      - "{{ .MainConfigDir }}:/etc/noops/nginx:ro"
      - "{{ .ConfigPath }}:/etc/nginx/conf.d:ro"
      - "{{ .ACMEWebroot }}:/var/www/certbot:ro"
      - "{{ .CertificateDir }}:/etc/letsencrypt:ro"
      - "{{ .ImportedCertificateDir }}:/etc/noops/certificates:ro"
    networks:
      "{{ .NetworkName }}":
        aliases:
          - "{{ .InternalHost }}"
{{ range .EnvironmentNetworks }}
      "{{ . }}":
        aliases:
          - "{{ $.InternalHost }}"
{{ end }}    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1/__noops/health || exit 1"]
      interval: 2s
      timeout: 1s
      retries: 3
      start_period: 5s
    deploy:
      replicas: {{ .Replicas }}
      update_config:
        parallelism: 1
        order: start-first
        monitor: 30s
        delay: 5s
        failure_action: rollback
        max_failure_ratio: 0
      rollback_config:
        parallelism: 1
        order: start-first
        monitor: 30s
        failure_action: pause
        max_failure_ratio: 0
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any
  certbot:
    image: certbot/certbot:latest
    # The image entrypoint is `certbot`; override it so this is a long-running
    # renewal service rather than arguments passed to the certbot CLI.
    entrypoint: ["/bin/sh", "-c"]
    command:
      - >-
        while :; do certbot renew --webroot --webroot-path /var/www/certbot;
        sleep 12h; done
    volumes:
      - "{{ .ACMEWebroot }}:/var/www/certbot:rw"
      - "{{ .CertificateDir }}:/etc/letsencrypt:rw"
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any

networks:
  "{{ .NetworkName }}":
    external: true
{{ range .EnvironmentNetworks }}
  "{{ . }}":
    external: true
{{ end }}
