version: "3.9"

services:
  nginx:
    image: nginx:1.28-alpine
    ports:
      - "{{ .HTTPPort }}:80"
      - "{{ .HTTPSPort }}:443"
    networks:
      - "{{ .NetworkName }}"
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1/ || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    deploy:
      replicas: 1
      restart_policy:
        condition: any

networks:
  "{{ .NetworkName }}":
    external: true
