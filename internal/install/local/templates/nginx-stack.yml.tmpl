version: "3.9"

services:
  nginx:
    image: nginx:1.28-alpine
    ports:
      - "{{ .HTTPPort }}:80"
      - "{{ .HTTPSPort }}:443"
    volumes:
      - "{{ .ConfigPath }}:/etc/nginx/conf.d:ro"
      - "{{ .ACMEWebroot }}:/var/www/certbot:ro"
      - "{{ .CertificateDir }}:/etc/letsencrypt:ro"
      - "{{ .ImportedCertificateDir }}:/etc/noops/certificates:ro"
    networks:
      "{{ .NetworkName }}":
        aliases:
          - "{{ .InternalHost }}"
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1/__noops/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any
  certbot:
    image: certbot/certbot:latest
    # The image entrypoint is `certbot`; override it so this is a long-running
    # renewal service rather than arguments passed to the certbot CLI.
    entrypoint: ["/bin/sh", "-c"]
    command:
      - >-
        apk add --no-cache docker-cli && while :; do certbot renew --webroot
        --webroot-path /var/www/certbot --deploy-hook 'nginx_containers="$(docker ps -q
        --filter label=com.docker.swarm.service.name={{ .NginxService }})"; test -n
        "$nginx_containers" && for nginx_container in $nginx_containers;
        do docker exec "$nginx_container" nginx -s reload; done'; sleep 12h; done
    volumes:
      - "{{ .ACMEWebroot }}:/var/www/certbot:rw"
      - "{{ .CertificateDir }}:/etc/letsencrypt:rw"
      - "/var/run/docker.sock:/var/run/docker.sock"
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any

networks:
  "{{ .NetworkName }}":
    external: true
