version: "3.9"

services:
  nginx:
    image: nginx:1.28-alpine
    # Reload its own configuration periodically. This lets certificate renewal
    # take effect without granting the certbot container Docker-host access.
    entrypoint: ["/bin/sh", "-c"]
    command:
      - >-
        nginx -t || exit $?; nginx -g 'daemon off;' & nginx_pid=$!; while kill -0 "$nginx_pid" 2>/dev/null;
        do sleep 5m & wait $!; nginx -t && nginx -s reload || true; done; wait "$nginx_pid"
    ports:
      - "{{ .HTTPPort }}:80"
      - "{{ .HTTPSPort }}:443"
    volumes:
      - "{{ .ConfigPath }}:/etc/nginx/conf.d:ro"
      - "{{ .ACMEWebroot }}:/var/www/certbot:ro"
      - "{{ .CertificateDir }}:/etc/letsencrypt:ro"
      - "{{ .ImportedCertificateDir }}:/etc/noops/certificates:ro"
    networks:
      "{{ .NetworkName }}":
        aliases:
          - "{{ .InternalHost }}"
{{ range .EnvironmentNetworks }}
      "{{ . }}":
        aliases:
          - "{{ $.InternalHost }}"
{{ end }}    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1/__noops/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any
  certbot:
    image: certbot/certbot:latest
    # The image entrypoint is `certbot`; override it so this is a long-running
    # renewal service rather than arguments passed to the certbot CLI.
    entrypoint: ["/bin/sh", "-c"]
    command:
      - >-
        while :; do certbot renew --webroot --webroot-path /var/www/certbot;
        sleep 12h; done
    volumes:
      - "{{ .ACMEWebroot }}:/var/www/certbot:rw"
      - "{{ .CertificateDir }}:/etc/letsencrypt:rw"
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any

networks:
  "{{ .NetworkName }}":
    external: true
{{ range .EnvironmentNetworks }}
  "{{ . }}":
    external: true
{{ end }}