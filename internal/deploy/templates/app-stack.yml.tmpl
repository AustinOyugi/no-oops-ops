version: "3.9"

services:
  {{ .ServiceName }}:
    image: {{ .Image }}
{{- if .UseWrapper }}
    entrypoint: ["/bin/sh", "/bootstrap.sh"]
    command: []
    environment:
      NOOPS_ORIGINAL_ENTRYPOINT_JSON: {{ yamlString .OriginalEntrypoint }}
      NOOPS_ORIGINAL_CMD_JSON: {{ yamlString .OriginalCmd }}
      NOOPS_SECRET_MAPPINGS_JSON: {{ yamlString .SecretMappingsJSON }}
{{- range .Secrets }}
      {{ .EnvKey }}_FILE: {{ yamlString (printf "/run/secrets/%s" .SecretName) }}
{{- end }}
{{- end }}
    env_file:
      - .env
{{- if .Secrets }}
    secrets:
{{- range .Secrets }}
      - source: {{ .SwarmName }}
{{- if $.UseWrapper }}
        target: {{ .SecretName }}
{{- else }}
        target: {{ .SecretName }}
{{- end }}
        mode: 0400
{{- end }}
{{- end }}
    healthcheck:
      test:
{{- range .HealthcheckTest }}
        - {{ . }}
{{- end }}
      start_period: {{ .HealthcheckStartPeriod }}
      interval: {{ .HealthcheckInterval }}
      timeout: {{ .HealthcheckTimeout }}
      retries: {{ .HealthcheckRetries }}
    deploy:
      replicas: {{ .Replicas }}
      restart_policy:
        condition: {{ .RestartCondition }}
        delay: {{ .RestartDelay }}
        max_attempts: {{ .RestartMaxAttempts }}
        window: {{ .RestartWindow }}
      update_config:
        parallelism: {{ .Parallelism }}
        delay: {{ .RolloutDelay }}
        order: {{ .RolloutOrder }}
        failure_action: {{ .FailureAction }}
    networks:
      - {{ .Network }}

networks:
  {{ .Network }}:
    external: true
{{- if .Secrets }}

secrets:
{{- range .Secrets }}
  {{ .SwarmName }}:
    external: true
{{- end }}
{{- end }}
